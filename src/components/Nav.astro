---
import { Moon, Sun } from "lucide-astro";
---

<header
    transition:persist
    class="flex items-center justify-between gap-8 px-4 py-6 font-mono max-w-4xl mx-auto text-stone-600 dark:text-white/50"
>
    <nav class="flex gap-8">
        <a href="/" class="no-underline transition-colors hover:text-black dark:hover:text-white"
            >home</a>
        <a href="/blog" class="no-underline transition-colors hover:text-black dark:hover:text-white"
            >blog</a>
    </nav>
    <button
        type="button"
        id="theme-toggle"
        class="shrink-0 rounded-md p-1.5 -m-1.5 text-stone-600 transition-colors hover:text-black dark:text-white/50 dark:hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-400 dark:focus-visible:outline-stone-500"
        aria-label="Toggle dark mode"
        aria-pressed="false"
    >
        <Moon class="dark:hidden" size={20} aria-hidden="true" />
        <Sun class="hidden dark:block" size={20} aria-hidden="true" />
    </button>
</header>

<script>
    const btn = document.getElementById("theme-toggle");

    function syncPressed() {
        btn?.setAttribute(
            "aria-pressed",
            String(document.documentElement.classList.contains("dark")),
        );
    }

    function setViewTransitionOriginFromButton() {
        const root = document.documentElement;
        if (btn) {
            const r = btn.getBoundingClientRect();
            root.style.setProperty("--theme-vt-x", `${r.left + r.width / 2}px`);
            root.style.setProperty("--theme-vt-y", `${r.top + r.height / 2}px`);
        }
    }

    function applyThemeToggle() {
        const root = document.documentElement;
        root.classList.toggle("dark");
        localStorage.setItem(
            "theme",
            root.classList.contains("dark") ? "dark" : "light",
        );
        syncPressed();
    }

    function runThemeTransition(apply: () => void) {
        if (!document.startViewTransition) {
            apply();
            return;
        }
        document.documentElement.classList.add("theme-vt");
        const vt = document.startViewTransition(apply);
        void vt.finished.finally(() => {
            document.documentElement.classList.remove("theme-vt");
        });
    }

    /** When the site follows the OS (no saved preference), sync when system theme changes. */
    const colorSchemeMq = window.matchMedia("(prefers-color-scheme: dark)");
    colorSchemeMq.addEventListener("change", () => {
        if (localStorage.getItem("theme")) return;
        const root = document.documentElement;
        const wantDark = colorSchemeMq.matches;
        if (root.classList.contains("dark") === wantDark) return;
        setViewTransitionOriginFromButton();
        runThemeTransition(() => {
            root.classList.toggle("dark", wantDark);
            syncPressed();
        });
    });

    btn?.addEventListener("click", (e) => {
        const root = document.documentElement;
        let x = e.clientX;
        let y = e.clientY;
        if (x === 0 && y === 0 && btn) {
            const r = btn.getBoundingClientRect();
            x = r.left + r.width / 2;
            y = r.top + r.height / 2;
        }
        root.style.setProperty("--theme-vt-x", `${x}px`);
        root.style.setProperty("--theme-vt-y", `${y}px`);

        runThemeTransition(applyThemeToggle);
    });

    syncPressed();
</script>
