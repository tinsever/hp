---
import Signature from "./Signature.astro";

const year = new Date().getFullYear();
---

<footer
    transition:persist
    class="shrink-0 py-6 text-sm"
>
    <div
        class="mx-auto grid max-w-2xl grid-cols-1 items-center gap-y-4 px-4 font-mono sm:grid-cols-[1fr_auto_1fr] sm:gap-x-4 sm:gap-y-0"
    >
        <p class="m-0 justify-self-center text-center sm:justify-self-start sm:text-left">
            © {year} Tin Sever
        </p>
        <div class="justify-self-center">
            <Signature />
        </div>
        <nav
            aria-label="Legal and source"
            class="flex flex-wrap justify-center gap-x-3 gap-y-1 sm:justify-self-end"
        >
            <a
                href="/legal"
                class="text-sm no-underline transition-colors hover:text-black dark:hover:text-white"
                >legal</a
            >
        </nav>
    </div>
</footer>
