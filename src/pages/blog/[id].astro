---
import Layout from "../../layouts/Layout.astro";
import BlogLicense from "../../components/BlogLicense.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("blog", ({ data }) =>
        import.meta.env.PROD ? data.draft !== true : true,
    );
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

function formatDate(d: Date) {
    return d.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
    });
}

function dateIso(d: Date) {
    return d.toISOString().slice(0, 10);
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = `${post.data.title} — Blog — Tin Sever`;

const licenseUrl = "https://creativecommons.org/licenses/by-sa/4.0/";
const structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    ...(post.data.updatedDate
        ? { dateModified: post.data.updatedDate.toISOString() }
        : {}),
    license: licenseUrl,
    author: {
        "@type": "Person",
        name: "Tin Sever",
    },
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<Layout title={title} description={post.data.description} ogType="article">
    <main>
        <div class="max-w-4xl px-4 mx-auto">
            <a
                href="/blog"
                class="font-mono text-sm no-underline text-stone-600 transition-colors hover:text-black dark:text-white/50 dark:hover:text-white"
                >← blog</a
            >
        </div>
        <article class="max-w-4xl px-4 mx-auto pb-4 pt-8">
            <header>
                <h1 class="font-light">{post.data.title}</h1>
                <p
                    class="mt-2 font-mono text-sm text-stone-500 dark:text-white/45"
                >
                    <time datetime={dateIso(post.data.pubDate)}>
                        {formatDate(post.data.pubDate)}
                    </time>
                    {
                        post.data.updatedDate ? (
                            <>
                                <span aria-hidden="true"> · </span>
                                <span>updated </span>
                                <time datetime={dateIso(post.data.updatedDate)}>
                                    {formatDate(post.data.updatedDate)}
                                </time>
                            </>
                        ) : null
                    }
                </p>
                <p class="mt-3 text-sm text-stone-600 dark:text-white/55">
                    {post.data.description}
                </p>
            </header>
            <div class="prosa mx-auto mt-10 w-full">
                <Content />
            </div>
            <BlogLicense
                variant="post"
                class="mt-12 max-w-2xl border-t border-stone-200 pt-8 dark:border-stone-700"
            />
        </article>
    </main>
    <script
        is:inline
        type="application/ld+json"
        set:html={structuredDataJson}></script>
</Layout>
