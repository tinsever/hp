---
import ProjectRow from "./ProjectRow.astro";

interface Project {
    name: string;
    href: string;
    desc: string;
}

interface Props {
    featured: Project[];
    more: Project[];
}

const { featured, more } = Astro.props;
---

<section class="max-w-4xl mx-auto px-4 mt-8">
    <h3 class="font-light">Projects</h3>
    <ul class="mt-5 space-y-3.5 list-none">
        {featured.map((p) => <ProjectRow {...p} />)}
    </ul>
    {
        more.length > 0 ? (
            <>
                <ul
                    id="projects-extra"
                    class="mt-3 hidden list-none space-y-3.5"
                    aria-hidden="true"
                >
                    {more.map((p) => (
                        <ProjectRow {...p} />
                    ))}
                </ul>
                <button
                    type="button"
                    id="projects-toggle"
                    class="mt-4 font-mono text-sm text-stone-600 transition-colors hover:text-black dark:text-white/50 dark:hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-400 dark:focus-visible:outline-stone-500"
                    aria-expanded="false"
                    aria-controls="projects-extra"
                >
                    Show more
                </button>
            </>
        ) : null
    }
</section>
{
    more.length > 0 ? (
        <script>
            const btn = document.getElementById("projects-toggle");
            const extra = document.getElementById("projects-extra");
            btn?.addEventListener("click", () => {
                extra?.classList.toggle("hidden");
                const expanded = !extra?.classList.contains("hidden");
                btn.textContent = expanded ? "Show less" : "Show more";
                btn.setAttribute("aria-expanded", String(expanded));
                extra?.setAttribute("aria-hidden", String(!expanded));
            });
        </script>
    ) : null
}
