---
import ProjectRow from "./ProjectRow.astro";

interface Project {
    name: string;
    href: string;
    desc: string;
    logo?: string;
    featured?: boolean;
    stars?: number;
}

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;
---

<section
    class="max-w-2xl mx-auto px-4 mt-14 grid gap-y-6 sm:grid-cols-[7rem_1fr] sm:gap-x-8"
    aria-labelledby="projects-heading"
>
    <h2
        id="projects-heading"
        class="text-base font-normal tracking-normal leading-[inherit] text-stone-500 dark:text-white/45"
    >
        Projects
    </h2>
    <ul class="list-none p-0 m-0 space-y-8">
        {projects.map((p) => <ProjectRow {...p} />)}
    </ul>
</section>
