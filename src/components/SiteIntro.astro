---
import { Github, Mail, Twitter } from "lucide-astro";
---

<div class="max-w-4xl px-4 mx-auto">
    <h1 class="font-light">Tin Sever</h1>
    <div
        class="flex items-center gap-4 py-3 text-stone-600 dark:text-white/50"
    >
        <a
            href="https://github.com/tinsever"
            class="rounded-md p-1 -m-1 no-underline transition-colors hover:text-black dark:hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-400 dark:focus-visible:outline-stone-500"
            aria-label="GitHub"
        >
            <Github size={20} aria-hidden="true" />
        </a>
        <a
            href="https://x.com/10xtin"
            class="rounded-md p-1 -m-1 no-underline transition-colors hover:text-black dark:hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-400 dark:focus-visible:outline-stone-500"
            aria-label="X (Twitter)"
        >
            <Twitter size={20} aria-hidden="true" />
        </a>
        <a
            href="mailto:mail@tin-sever.de"
            class="rounded-md p-1 -m-1 no-underline transition-colors hover:text-black dark:hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-400 dark:focus-visible:outline-stone-500"
            aria-label="Email"
        >
            <Mail size={20} aria-hidden="true" />
        </a>
    </div>
</div>
