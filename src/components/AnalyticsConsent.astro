---
---

<div
    id="analytics-consent-banner"
    role="dialog"
    aria-modal="false"
    aria-labelledby="analytics-consent-title"
    class="fixed inset-x-0 bottom-0 z-50 hidden w-full rounded-t-xl border-t border-stone-200/90 bg-amber-50/95 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] pt-3 text-stone-800 shadow-[0_-8px_32px_rgba(0,0,0,0.08)] backdrop-blur-sm dark:border-stone-600/90 dark:bg-stone-900/95 dark:text-stone-200 sm:inset-x-auto sm:bottom-4 sm:right-4 sm:left-auto sm:w-auto sm:max-w-[18rem] sm:rounded-lg sm:border sm:px-3 sm:py-2.5 sm:pb-2.5 sm:shadow-lg"
>
    <div class="mx-auto flex w-full max-w-4xl flex-col gap-3 sm:mx-0 sm:max-w-none sm:gap-2">
        <div class="min-w-0 text-xs leading-snug sm:text-xs">
            <p id="analytics-consent-title" class="font-medium text-black dark:text-white">
                Analytics (optional)
            </p>
            <p class="mt-1 text-stone-600 dark:text-stone-400">
                With your consent, this site uses{" "}
                <a
                    href="https://posthog.com/"
                    class="text-black underline decoration-stone-400 underline-offset-2 hover:decoration-black dark:text-white dark:hover:decoration-white"
                    rel="noopener noreferrer"
                    target="_blank"
                    >PostHog</a
                >
                {" "}
                (EU) for analytics. Decline = no tracking.{" "}
                <a href="/legal#analytics-posthog" class="underline decoration-stone-400 underline-offset-2 hover:decoration-black dark:hover:decoration-white"
                    >Privacy</a
                >.
            </p>
        </div>
        <div class="grid grid-cols-2 gap-2 sm:flex sm:justify-end sm:gap-1.5">
            <button
                type="button"
                id="analytics-consent-decline"
                class="rounded border border-stone-300 bg-stone-100/90 px-3 py-2 text-xs font-medium text-stone-800 transition-colors hover:bg-stone-200/90 dark:border-stone-600 dark:bg-stone-800/90 dark:text-stone-200 dark:hover:bg-stone-700/90 sm:px-2.5 sm:py-1"
            >
                Decline
            </button>
            <button
                type="button"
                id="analytics-consent-accept"
                class="rounded border border-stone-300 bg-stone-100/90 px-3 py-2 text-xs font-medium text-stone-800 transition-colors hover:bg-stone-200/90 dark:border-stone-600 dark:bg-stone-800/90 dark:text-stone-200 dark:hover:bg-stone-700/90 sm:px-2.5 sm:py-1"
            >
                Accept
            </button>
        </div>
    </div>
</div>

<script is:inline>
    (function () {
        var KEY = "posthog_analytics_consent";
        var banner = document.getElementById("analytics-consent-banner");
        if (!banner) return;
        try {
            var v = localStorage.getItem(KEY);
            if (v === "granted" || v === "denied") return;
        } catch (e) {
            return;
        }
        banner.classList.remove("hidden");

        function hide() {
            banner.classList.add("hidden");
        }

        document.getElementById("analytics-consent-accept")?.addEventListener("click", function () {
            try {
                localStorage.setItem(KEY, "granted");
            } catch {
                /* ignore */
            }
            if (typeof posthog !== "undefined" && posthog.opt_in_capturing) {
                posthog.opt_in_capturing();
            }
            hide();
        });

        document.getElementById("analytics-consent-decline")?.addEventListener("click", function () {
            try {
                localStorage.setItem(KEY, "denied");
            } catch {
                /* ignore */
            }
            if (typeof posthog !== "undefined" && posthog.opt_out_capturing) {
                posthog.opt_out_capturing();
            }
            hide();
        });
    })();
</script>
