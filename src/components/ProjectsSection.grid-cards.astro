---
interface Project {
    name: string;
    href: string;
    desc: string;
}

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;
---

<section class="max-w-4xl mx-auto px-4 mt-8">
    <h3 class="font-light">Projects</h3>
    <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-x-3 sm:gap-x-4 gap-y-8 list-none p-0">
        {
            projects.map((p) => (
                <li class="min-w-0">
                    <a
                        href={p.href}
                        class="group block no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stone-400 dark:focus-visible:outline-stone-500 rounded-lg"
                    >
                        <div
                            class="w-full rounded-lg aspect-[1200/630] shadow-sm ring-1 ring-stone-900/5 dark:ring-white/10 transition group-hover:ring-stone-900/10 dark:group-hover:ring-white/15 bg-stone-100 dark:bg-stone-800/30 overflow-hidden relative select-none"
                            aria-hidden="true"
                        >
                            <div class="absolute inset-0 p-4 text-stone-300/40 dark:text-stone-700/40 font-mono text-2xl font-black uppercase leading-none whitespace-pre-wrap break-words break-all">
                                {Array(50).fill(p.name).join(" • ")}
                            </div>
                        </div>
                        <h4 class="mt-2.5 font-mono text-sm text-stone-900 transition-colors group-hover:text-black dark:text-stone-100 dark:group-hover:text-white">
                            {p.name}
                        </h4>
                        <p class="mt-1 text-sm text-stone-600 dark:text-white/55 leading-snug">
                            {p.desc}
                        </p>
                    </a>
                </li>
            ))
        }
    </ul>
</section>
